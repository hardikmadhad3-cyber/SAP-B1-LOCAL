{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.6",
    "bootstrap": "^5.3.8",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "prestart": "node scripts/prepare-pdf-assets.js",
    "prebuild": "node scripts/prepare-pdf-assets.js",
    "start": "craco start",
    "build": "craco build && npm run compress && npm run validate:bundle",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "compress": "node scripts/compress-assets.js",
    "validate:bundle": "node scripts/validate-bundle-size.js",
    "analyze": "source-map-explorer 'build/static/js/*.js' --html build/bundle-analysis.html",
    "build:analyze": "set ANALYZE=true&& craco build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "react-hooks/exhaustive-deps": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@lhci/cli": "^0.15.1",
    "compression-webpack-plugin": "^12.0.0",
    "source-map-explorer": "^2.5.3",
    "webpack-bundle-analyzer": "^5.3.0"
  }
}
